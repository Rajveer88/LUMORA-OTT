{
  "name": "many-systems-one-builder",
  "version": "1.0.0",
  "description": "40-second cinematic portfolio film — one person, many systems, one continuous creative mind",
  "scripts": {
    "audio": "node tools/make-audio.mjs",
    "plates": "node tools/prepare-plates.mjs",
    "preview": "remotion studio PortfolioFilm",
    "render": "remotion render PortfolioFilm out/film.mp4 --browser-executable=./run-chromium.sh --concurrency=1",
    "render:720": "remotion render PortfolioFilm out/film-720.mp4 --browser-executable=./run-chromium.sh --concurrency=1 --width=1280 --height=720",
    "still": "remotion still PortfolioFilm --browser-executable=./run-chromium.sh"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.524",
    "@remotion/cli": "4.0.524",
    "@remotion/renderer": "4.0.524",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "remotion": "4.0.524",
    "three": "^0.169.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
